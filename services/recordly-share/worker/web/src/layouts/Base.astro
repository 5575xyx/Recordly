---
interface Props {
  title: string;
}
import '../styles/global.css';

const { title } = Astro.props;
---

<!DOCTYPE html>
<html lang="en" class="dark">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="color-scheme" content="dark">
  <title>{title}</title>
  <slot name="head" />
</head>
<body>
  <slot />
</body>
</html>
